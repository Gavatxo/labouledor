# ── Base de données (Neon Postgres via le Marketplace Vercel) ──
# En local : chaîne d'un Postgres local. En prod : la chaîne fournie par Neon.
DATABASE_URL="postgresql://user:password@host:5432/labouledor"

# ── Back-office ──
# Mot de passe partagé pour se connecter à /admin.
ADMIN_PASSWORD="choisis-un-mot-de-passe-solide"
# Secret aléatoire pour signer les cookies de session (ex. `openssl rand -base64 32`).
SESSION_SECRET="remplace-par-une-longue-chaine-aleatoire"
